# Master / Default Gemini API Key
# INSTRUCTIONS: Enter your real Gemini API key from Google AI Studio (https://aistudio.google.com/app/apikey)
# in the 'Secrets' panel in AI Studio sidebar to make the AI features work.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Dedicated API Key for Daily Practice AI Generator (Optional - defaults to GEMINI_API_KEY)
GEMINI_DAILY_PRACTICE_KEY=YOUR_GEMINI_API_KEY_HERE

# Dedicated API Key for AI Doubt Solver (Optional - defaults to GEMINI_API_KEY)
GEMINI_DOUBT_SOLVER_KEY=YOUR_GEMINI_API_KEY_HERE

# Dedicated API Key for AI College Recommender & Predictor (Optional - defaults to GEMINI_API_KEY)
GEMINI_COLLEGE_RECOMMENDER_KEY=YOUR_GEMINI_API_KEY_HERE

# Automatic Failover / Backup Gemini Keys (Optional)
GEMINI_BACKUP_KEY_1=YOUR_BACKUP_KEY_HERE
GEMINI_BACKUP_KEY_2=YOUR_BACKUP_KEY_HERE

